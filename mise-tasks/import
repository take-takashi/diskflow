#!/usr/bin/env bash
#MISE description="CDを自動検出し、保存用captureと完成品AACを生成"
#MISE quiet=true
#MISE raw=true
#USAGE unknown_flags "error"
#USAGE arg "[source]" help="CDなしで作り直す場合の保存フォルダ（captureまたはアルバム全体）"
#USAGE flag "-o --output <dir>" help="新しい保存先（省略時は ~/Music/diskflow/日時、上書き不可）"
#USAGE flag "--artwork <file>" help="使うカバー画像（省略時は保存済み画像、cover.jpg/cover.png、DB画像の順）"
#USAGE flag "--search <query>" help="自動照合できない場合の検索語（アーティスト名・アルバム名）"
#USAGE flag "--edition <label>" help="版の記録用ラベル（例: 初回限定盤）"
#USAGE flag "--non-interactive" help="候補の番号選択や検索語の入力を求めず、不明な場合は停止"
#USAGE flag "--device <device>" hide=#true help="音楽CDのrawデバイスを明示指定"
#USAGE flag "--capture <dir>" hide=#true help="再生成する保存済みcapture（旧形式の指定方法）"
#USAGE flag "--apple-album-id <id>" hide=#true help="AppleアルバムIDを明示指定"
#USAGE flag "--release-id <id>" hide=#true help="MusicBrainzリリースIDを明示指定"
#USAGE flag "--passes <count>" default="2" help="CDの読み取り回数（2以上）"
#USAGE flag "--retries <count>" default="2" help="読み取りエラー時の追加試行回数"
#USAGE flag "--chunk-sectors <count>" default="16" help="1回に読むセクター数（1〜75）"
#USAGE flag "--target-lufs <lufs>" help="曲別の音量目標（通常-14、再生成時は保存設定を使用）"
#USAGE flag "--true-peak <dbtp>" help="True Peak上限（通常-1、再生成時は保存設定を使用）"
#USAGE flag "--peak-headroom <db>" help="追加のピーク余裕（通常0.05、再生成時は保存設定を使用）"

set -euo pipefail
exec uv run --locked python -m diskflow.workflow
